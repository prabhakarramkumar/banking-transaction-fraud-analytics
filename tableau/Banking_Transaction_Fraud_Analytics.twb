                  <run fontalignment='1' fontcolor='#000000' fontsize='11'>: PaySim (6.36 Million Simulated Banking Transactions) </run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='11'>Tools</run>
                  <run fontalignment='1' fontcolor='#000000' fontsize='11'>: SQL • Python • Tableau </run>
                  <run fontalignment='1'>Æ&#10;</run>
